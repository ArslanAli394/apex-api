# Environment variables for Apex API

# Application settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="Apex Operations API"
APP_VERSION="1.0.0"

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database settings
DB_USER=apex_user
DB_PASSWORD=apex_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apex_db
DATABASE_URL=postgresql://apex_user:apex_password@localhost:5432/apex_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_TIMEOUT=5

# API Configuration
API_PREFIX=/api/v1
ENABLE_DOCS=true

# PgAdmin settings (for development)
PGADMIN_EMAIL=admin@apex.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# AWS Configuration (for cloud deployment)
AWS_REGION=us-east-1
AWS_ECR_REGISTRY=123456789.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY_NAME=apex-api
